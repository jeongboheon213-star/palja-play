# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
#
# Vercel: Vercel–Supabase 연동이 만든 SUPABASE_URL / SUPABASE_ANON_KEY 를 자동으로 읽으므로 따로 넣지 않아도 됩니다.
#         다른 값을 쓰고 싶을 때만 PALJA_* 이름으로 넣으면 그것이 우선합니다.
# 브라우저에는 URL 과 공개(anon/publishable) 키만 들어갑니다. 관리자 키가 들어오면 빌드가 멈춥니다.

# Supabase 대시보드 → Project Settings → API Keys 의 Project URL
PALJA_SUPABASE_URL=
# 같은 화면의 publishable (공개) 키. secret / service_role 키는 절대 넣지 마세요.
PALJA_SUPABASE_ANON_KEY=
# 배포 후 공유 문구에 붙일 공개 주소 (예: https://palja-play.vercel.app)
PALJA_PUBLIC_URL=

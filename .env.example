# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
# Vercel 에서는 Project Settings → Environment Variables 에 같은 이름으로 넣습니다.

# Supabase 대시보드 → Project Settings → API (또는 Data API) 의 Project URL
PALJA_SUPABASE_URL=
# 같은 화면의 anon / publishable (공개) 키. service_role / secret 키는 절대 넣지 마세요.
PALJA_SUPABASE_ANON_KEY=
# 배포 후 공유 문구에 붙일 공개 주소 (예: https://palja-play.vercel.app)
PALJA_PUBLIC_URL=
